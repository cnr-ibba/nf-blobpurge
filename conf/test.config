/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    All test data under assets/test/ is synthetic (see
    assets/test/generate_test_data.py): a 9-contig, gzipped toy assembly
    with two intentionally near-duplicate ("heterozygous haplotig") contig
    pairs and two "contaminant" contigs, plus matching paired-end reads and
    a hand-built BlobDir. It is a plumbing fixture, not biologically real
    data.

    Use as follows:
        nextflow run cnr-ibba/nf-blobpurge -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '8.GB',
        time: '1.h'
    ]
}

// nf-schema resolves relative paths in a samplesheet against the launch
// directory, not the CSV's own location, so the bundled local test data
// needs a samplesheet with absolute paths. It is generated here, at
// config-load time, from ${projectDir} so it stays portable across checkouts.
def blobpurge_test_samplesheet = new File("${System.getProperty('java.io.tmpdir')}/blobpurge_test_samplesheet_${System.getProperty('user.name')}.csv")
blobpurge_test_samplesheet.text = [
    'sample_id,assembly,blobdir,reads_cram,reads_r1,reads_r2',
    [
        'blobpurge_test',
        "${projectDir}/assets/test/assembly.fasta.gz",
        "${projectDir}/assets/test/blobdir",
        '',
        "${projectDir}/assets/test/reads_R1.fastq.gz",
        "${projectDir}/assets/test/reads_R2.fastq.gz",
    ].join(',')
].join('\n') + '\n'

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal synthetic dataset to check pipeline function end-to-end'

    // Input data (see assets/test/); samplesheet generated above.
    input = blobpurge_test_samplesheet.toString()

    // BTK_FILTER: --taxrule is deliberately left unset here to also exercise
    // the meta.json-based auto-detection path (see bin/detect_taxrule.py).
    exclude_taxa = 'Pseudomonadota,Bacteroidota'
    taxon_field  = 'buscoregions_phylum'

    // A tiny, fast-to-download lineage is used purely to keep CI runtime
    // down; it is not biologically appropriate for the synthetic contigs.
    busco_lineages = 'bacteria_odb10'

    run_purge_haplotigs = true

    // HaploMerger2 needs no reads and would reuse assembly.fasta as-is, but
    // is left off here. Verified against a real container (see
    // docker/haplomerger2/Dockerfile): HAPLOMERGER2_STAGE_A/_B run their
    // actual logic, and two real bugs were found and fixed along the way
    // (SHELLOPTS inheritance from Nextflow's own strict-mode task wrapper,
    // and a PATH-shadowing issue where the ancient kentUtils binaries
    // bundled alongside faToNib silently masked the modern bioconda ones --
    // both fixed directly in the module scripts). Even with both fixes,
    // hm.batchA2's reciprocal-best chain/net computation intermittently
    // produces empty/incorrect output on this container/environment (all
    // commands exit 0; no error surfaces), which HM_pathFinder_preparation.pl
    // then reports as if the alignment graph were too sparse. Root cause not
    // isolated further -- this is not a fixture-density problem (already
    // enriched to 2 duplicate pairs / 7 post-filter scaffolds) and growing
    // it further would not help. See docs/usage.md.
    run_haplomerger2       = false
    haplomerger2_container = 'docker.io/bunop/nf-blobpurge-haplomerger2:11bd1efe3fd925c2'
}
