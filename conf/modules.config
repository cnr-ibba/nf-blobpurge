/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'BLOBPURGE_REPORT' {
        publishDir = [
            path: { "${params.outdir}/analyses" },
            mode: params.publish_dir_mode,
            pattern: '*_blobpurge.html'
        ]
    }

    withName: 'BUSCO' {
        // Lineage data is downloaded once (BUSCO_DOWNLOAD) and reused across
        // every stage/chunk unless --busco_lineages_path is given.
        ext.args = ''
    }

    withName: 'BUSCO_DOWNLOAD' {
        // Downloaded once per unique lineage and merged by
        // MERGE_BUSCO_DOWNLOADS; not useful per-run output.
        publishDir = [ enabled: false ]
    }

    withName: 'MERGE_BUSCO_DOWNLOADS' {
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_DEPTH' {
        // Report zero-coverage positions too, as the local wrapper this replaced did.
        ext.args = '-a'
    }

    withName: 'SAMTOOLS_SORT_NAME.*' {
        // purge_dups' ngscstat needs a name-sorted (not coordinate-sorted) BAM.
        // Regex selector: also covers SAMTOOLS_SORT_NAME_ORGANELLE, the
        // alias used by ORGANELLE_ISOLATE (a process can only be invoked
        // once per workflow scope without a distinct alias).
        ext.args = '-n'
    }

    // Every process below tokenizes to the same auto-derived 'samtools/'
    // publishDir (see the default publishDir formula above) and, without an
    // explicit prefix, the nf-core samtools/sort module names its output
    // '<meta.id>.bam' regardless of alias -- identical to the coordinate-sorted
    // SAMTOOLS_SORT output also published there. All three processes (this
    // one, SAMTOOLS_SORT_NAME_ORGANELLE, and the coordinate SAMTOOLS_SORT in
    // bam_sort_stats_samtools) were silently racing to publish
    // 'samtools/<meta.id>.bam', with whichever task finished last
    // non-deterministically overwriting the others. Distinct prefixes
    // disambiguate the filenames so each is published separately.
    withName: 'SAMTOOLS_SORT_NAME' {
        ext.prefix = { "${meta.id}.namesorted" }
    }

    withName: 'SAMTOOLS_SORT_NAME_ORGANELLE' {
        ext.prefix = { "${meta.id}.organelle.namesorted" }
    }

    withName: 'CRAM_TO_BAM_RAW' {
        // ORGANELLE_ISOLATE's alias of CRAM_TO_BAM (see subworkflows/local/
        // organelle_isolate.nf), producing a raw-assembly-wide BAM instead
        // of READ_COVERAGE's BTK_FILTER-retained-contigs subset. Both tokenize
        // to the same auto-derived 'cram/' publishDir and, without an
        // explicit prefix, would both publish '<meta.id>.coverage.sorted.bam'.
        ext.prefix = { "${meta.id}.raw" }
    }

    withName: 'ORGANELLE_MERGE_FASTA_FILTERED' {
        // All three aliases publish to the same auto-derived organelle/
        // directory (see the default publishDir formula above); distinct
        // prefixes avoid a same-sample filename collision between them.
        ext.prefix = { "${meta.id}.filtered" }
    }

    withName: 'ORGANELLE_MERGE_FASTA_PURGEDUPS' {
        ext.prefix = { "${meta.id}.purge_dups" }
    }

    withName: 'ORGANELLE_MERGE_FASTA_PURGEHAPLOTIGS' {
        ext.prefix = { "${meta.id}.purge_haplotigs" }
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
